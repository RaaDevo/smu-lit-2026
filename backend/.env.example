# Mock mode is the safe default and needs no external credentials.
USE_MOCK_AI=true

# OpenRouter live mode. Use the exact organiser-provided model identifier.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Comma-separated frontend origins.
ALLOWED_ORIGINS=http://localhost:3000

