# Mock mode is the safe default and needs no external credentials.
USE_MOCK_AI=true

# OpenRouter live mode. Use the exact organiser-provided model identifier.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Comma-separated frontend origins.
ALLOWED_ORIGINS=http://localhost:3000

# Each model call gets at most 25 seconds; one schema/provenance repair at most.
AI_TIMEOUT_SECONDS=25
# Set json_object if the selected model does not support strict JSON Schema.
OPENROUTER_OUTPUT_MODE=json_schema

# Public project identifier only. No service-account private key is needed.
FIREBASE_PROJECT_ID=lit2026
REQUIRE_AUTH=false
# Set production on deployed servers; refuses startup without REQUIRE_AUTH=true.
APP_ENV=development
